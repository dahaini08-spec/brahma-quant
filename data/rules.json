      "id": "fr_short_block",
      "name": "资金费率负值禁止做空",
      "type": "block",
      "direction": "SHORT",
      "condition": "funding_rate < threshold",
      "threshold": -0.002,
      "confidence": 0.85,
      "source": "manual",
