# ============================================================
# 梵天量化系统 — 环境变量模板
# [设计院封印 2026-08-13 苏摩111]
# 用法: cp .env.example .env && 编辑 .env 填入真实值
# ============================================================

# ── Binance API ─────────────────────────────────────────────
# Portfolio Margin 账户 API Key（需要合约交易权限）
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_API_SECRET=your_binance_secret_here

# ── 系统配置 ────────────────────────────────────────────────
# 是否使用测试网（true=testnet, false=mainnet）
BINANCE_TESTNET=false

# ── 可选：OpenClaw Jarvis 推送（已在openclaw.json配置则不需要）
# JARVIS_USER_ID=your_user_id
# JARVIS_THREAD_ID=your_thread_id
